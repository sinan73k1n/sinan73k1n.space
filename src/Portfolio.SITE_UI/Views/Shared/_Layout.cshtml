@*
    _Layout — portfolyo ana kalıbı.
    ⛔ CDN/dış istek YOK: fontlar self-host (wwwroot/fonts); bootstrap/jquery kaldırıldı.
    Arka plan katmanı SABİT (position: fixed), içerik onun üstünde akar.
*@
<!DOCTYPE html>
<html lang="@(ViewData["Lang"] as string ?? "tr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Ana sayfada yalnız ad; alt sayfalarda "Başlık · Sinan Tekin" *@
    @{
        var baslik = ViewData["Title"] as string ?? "";
        var tamBaslik = string.IsNullOrEmpty(baslik) || baslik == "Sinan Tekin"
            ? "Sinan Tekin" : $"{baslik} · Sinan Tekin";
    }
    <title>@tamBaslik</title>
    <meta name="description" content="@(ViewData["Description"] as string ?? "")" />
    <meta name="color-scheme" content="dark" />

    @* --- Site ikonu (Faz 9.5) — terminal istemi `>_`, tek yön palet.
       Kaynak: wwwroot/icon.svg; türevleri `node tools/ikon-uret.js` üretir.
       Sıra bilinçli: **.ico ÖNCE**, SVG sonra. SVG bir gün yine geçersiz olursa
       (bkz. icon.svg içindeki XML yorumu uyarısı) tarayıcı .ico'ya düşer.
       `asp-append-version` ŞART: ikon dosyaları Cloudflare'de 4 saat önbelleğe alınıyor;
       içerik değişince adres de değişsin ki elle purge gerekmesin. *@
    <link rel="icon" href="~/favicon.ico" sizes="16x16 32x32 48x48" asp-append-version="true" />
    <link rel="icon" href="~/icon.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/site.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#141622" />

    @* --- SEO / paylaşım (Faz 7) ---
       Site TEK sayfa, diller `?lang=` ile ayrılıyor. Bu yüzden:
         · canonical  → o dilin adresi (dil seçilmemişse dilsiz kök)
         · hreflang   → üç dil KARŞILIKLI bağlanır + x-default kök adres
       Adresler istekten türetilir (ters vekilin şeması UseForwardedHeaders ile doğru gelir),
       böylece alan adı ne koda ne yapılandırmaya gömülür. *@
    @{
        var origin = $"{Context.Request.Scheme}://{Context.Request.Host.Value}";
        var aktifDil = ViewData["Lang"] as string;
        var dilSecildi = !string.IsNullOrEmpty(Context.Request.Query["lang"]);
        var canonical = dilSecildi ? $"{origin}/?lang={aktifDil}" : $"{origin}/";
    }
    <link rel="canonical" href="@canonical" />
    @foreach (var d in Portfolio.Entities.Lang.All)
    {
        <link rel="alternate" hreflang="@d" href="@($"{origin}/?lang={d}")" />
    }
    <link rel="alternate" hreflang="x-default" href="@($"{origin}/")" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Sinan Tekin" />
    <meta property="og:title" content="@tamBaslik" />
    <meta property="og:description" content="@(ViewData["Description"] as string ?? "")" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="@(aktifDil == "tr" ? "tr_TR" : aktifDil == "ru" ? "ru_RU" : "en_US")" />
    @* og:image (Faz 7.4) — sitenin kendi görsel dilinden üretilmiş 1200×630 kart.
       ⚠️ Kart METNİ DİLDEN BAĞIMSIZ (ad · teknolojiler · adres): site üç dilli, karta
       çevrilebilir bir slogan koymak üç ayrı görsel + üç ayrı bakım noktası demekti.
       Adres mutlak olmalı — paylaşım botları göreli yolu çözmez. *@
    <meta property="og:image" content="@($"{origin}/og-image.png")" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sinan Tekin — Unity · ASP.NET Core · C#" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/background.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    @* ⭐ Hareket kancası: `.anim` sınıfı SADECE reduced-motion kapalıysa eklenir.
       CSS'teki başlangıç durumları (opacity:0 vb.) yalnız bu sınıf altında geçerli →
       JS yoksa ya da kullanıcı hareketi azaltmışsa içerik görünür kalır, kilitlenmez.
       CSS'ten ÖNCE değil, render'dan ÖNCE çalışması yeter (FOUC olmaz). *@
    <script>
        (function () {
            try {
                if (!window.matchMedia || !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    document.documentElement.classList.add("anim");
                }
            } catch (e) { }
        })();
    </script>
</head>
<body>
    @* Sabit arka plan: radial taban + 3 ışık bulutu + 2 huzme + 16 veri hattı *@
    <div class="bg-layer" aria-hidden="true">
        <div class="bg-glow bg-glow--1"></div>
        <div class="bg-glow bg-glow--2"></div>
        <div class="bg-glow bg-glow--3"></div>

        <div class="bg-beams">
            <div class="bg-beam bg-beam--1"></div>
            <div class="bg-beam bg-beam--2"></div>
        </div>

        <div class="bg-streams" data-streams></div>
    </div>

    <div class="page">
        @RenderBody()
    </div>

    <script src="~/js/streams.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
